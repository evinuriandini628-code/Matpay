# ==============================
# CUMA 2 VARIABEL DI VERCEL!
# ==============================

# 1. Frontend Firebase Config (copy dari Firebase Console → Project Settings → Web App)
VITE_FIREBASE_CONFIG={"apiKey":"xxx","authDomain":"matpay.firebaseapp.com","projectId":"matpay","storageBucket":"matpay.appspot.com","messagingSenderId":"123","appId":"1:123:web:abc"}

# 2. Backend Service Account (copy isi file JSON dari Firebase Console → Service Accounts → Generate Key)
FIREBASE_SERVICE_ACCOUNT={"project_id":"matpay","client_email":"firebase-adminsdk@matpay.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n"}
